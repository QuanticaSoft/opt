[Unit]
Description=Gyros Union HTTP Server (saldo/debito) - scz01
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agentescz1
WorkingDirectory=/opt/gyros/agent
ExecStart=/opt/gyros/agent/.venv/bin/python3 -m union.server
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
